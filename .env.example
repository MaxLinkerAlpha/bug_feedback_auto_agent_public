# ================= 大模型双轨路由配置 =================
# 【获取方式】访问 https://www.siliconflow.cn 注册账号，实名认证后获取 API Key
AI_API_KEY="sk-your_api_key_here"
AI_BASE_URL="https://api.siliconflow.cn/v1"

# 廉价/极速模型（短文本路由到此）
AI_MODEL_CHEAP="deepseek-ai/DeepSeek-V3.2"

# 重型/长上下文模型（宏观总结路由到此）
AI_MODEL_HEAVY="deepseek-ai/DeepSeek-V3.2"

# ================= 飞书应用凭证 =================
# 【获取方式】https://open.feishu.cn/app → 创建应用 → 凭证与基础信息
FEISHU_APP_ID="cli_your_app_id"
FEISHU_APP_SECRET="your_app_secret"

# ================= 飞书多维表格参数 =================
FEISHU_APP_TOKEN="your_app_token"
FEISHU_TABLE_ID="tbl_your_table_id"

# ================= 代理配置（自动检测，无需手动配置） =================
# 优先级: 用户代理(17890等) → PROXY_URL 自定义 → 直连
# 如需强制指定: PROXY_URL="http://127.0.0.1:17890"

# ================= Steam 配置 =================
STEAM_APP_ID="your_steam_app_id"
STEAM_MAX_ANNOUNCEMENTS=2
STEAM_MAX_DISCUSSIONS=20
STEAM_FETCH_MODE="all"
STEAM_IGNORE_HISTORY="False"

# ================= 腾讯频道配置 =================
TENCENT_CHANNEL_URL="https://pd.qq.com/g/your_channel_id"
TENCENT_MAX_POSTS=20
HEADLESS_MODE="True"

# ================= Reddit 配置 =================
REDDIT_SUBREDDIT="your_subreddit"
REDDIT_FETCH_LIMIT=15
REDDIT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
REDDIT_FEISHU_TABLE_ID="tbl_optional_table_id"

# ================= Discord 配置 =================
# 【获取方式】Discord 网页版 F12 → Network → 找 /api/v9/channels 请求的 Authorization 头
DISCORD_USER_TOKEN="your_discord_user_token"
DISCORD_FETCH_LIMIT=15
DISCORD_FEISHU_TABLE_ID="tbl_optional_table_id"

# 服务器 ID（用于拼接帖子永久链接）
DISCORD_GUILD_ID="your_guild_id"

# 目标频道映射：频道ID=语义名，多个用英文逗号分隔
# 获取频道 ID：Discord 设置 → 高级 → 开启开发者模式 → 右键频道 → 复制频道 ID
DISCORD_CHANNELS="111111111111111111=[Discord] Bug Reports,222222222222222222=[Discord] General Feedback"

# 频道采集时间上限（天）：频道ID=天数，逗号分隔；未列出的频道不限制
DISCORD_CHANNEL_MAX_AGE="111111111111111111=30"

# ================= 百度贴吧配置 =================
# 目标贴吧名称（中文名，无需后缀）
TIEBA_KW="你的游戏名"
TIEBA_FETCH_LIMIT=15
TIEBA_MAX_REPLIES=0
TIEBA_MAX_DAYS=30
TIEBA_HEADLESS="True"

# ================= 小黑盒配置 =================
# 目标官方号 UID：打开主页 https://www.xiaoheihe.cn/app/user/profile/<UID> 中的数字段
XIAOHEIHE_USER_ID="your_xiaoheihe_user_id"
XIAOHEIHE_MAX_POSTS=30
XIAOHEIHE_WINDOW_DAYS=30
XIAOHEIHE_HEADLESS_MODE="True"

# ================= bilibili 配置 =================
# Cookie 由浏览器导出插件保存为 bilibili_cookies.json（已 gitignore）
BILI_COOKIES_FILE="bilibili_cookies.json"
BILI_MSGFETCH_LIMIT=20
